{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "target": "ES2023"
  },
  "include": ["assets/src/**/*.ts", "assets/src/**/*.svelte", "vite.config.ts", "playwright.config.ts", "tests/**/*.ts"]
}
